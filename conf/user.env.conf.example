#User defined env variables, this file overrides the env defined in the default env.conf file

# OCI image used by `ramalama serve` to run the model.
#export RAMALAMA_IMAGE="localhost/my-ramalama-asahi:latest"
# OCI image used by ramalama for RAG support.
#export RAMALAMA_RAG_IMAGE="quay.io/ramalama/ramalama-rag:latest"

# llama.cpp env vars applied to every model, merged with any per-model
# entry from MODEL_PARAMS below.
#export DEFAULT_RAMALAMA_ENV="GGML_KLEIDIAI_SME=1,LLAMA_ARGS_TOOLS=1,LLAMA_ARG_CACHE_PROMPT=1,LLAMA_ARG_MLOCK=1"

# Params applied when a model has no benchmark optimizations yet.
#export DEFAULT_MODEL_PARAMS="LLAMA_ARG_UBATCH_SIZE=512,LLAMA_ARG_BATCH_SIZE=512"

# Model auto-started by --start-rpc (non-interactive RPC bootstrap for VSCode);
# must already be pulled locally.
#export DEFAULT_RPC_MODEL="hf://Jackrong/Qwopus3.5-9B-Coder-GGUF:IQ4_XS"

# Extra flags appended verbatim to every 'ramalama serve' invocation.
# CPU-only example:  export RAMALAMA_ADDITIONAL_ARGS="--device none -t 8 --ngl 0"
# GPU example:       export RAMALAMA_ADDITIONAL_ARGS="--device /dev/dri"
#export RAMALAMA_ADDITIONAL_ARGS=""

# Cores 'ramalama serve' is pinned to via taskset (empty = no pinning).
#export CPU_AFFINITY="0-3"
